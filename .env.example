# ============================================================
# VCDetection Backend — Variables de entorno
# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env real a GitHub.
# ============================================================

# --- Base de datos PostgreSQL (Supabase / Render) ---
DATABASE_URL=postgresql://usuario:password@host:5432/vcdetection
DIRECT_URL=postgresql://usuario:password@host:5432/vcdetection

# --- JWT ---
# Genera uno seguro con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- API key de dispositivos ESP32 ---
# Debe coincidir con DEVICE_API_KEY en el firmware (.ino).
# El backend rechaza lecturas sin el header x-device-key correcto.
DEVICE_API_KEY=genera-una-clave-larga-y-aleatoria-aqui

# --- CORS ---
# Orígenes permitidos para el dashboard y la app móvil, separados por coma.
# Ejemplo: http://localhost:5173,https://tu-dashboard.onrender.com
# Si se deja vacío, se permiten todos los orígenes (no recomendado en producción).
CORS_ORIGIN=

# --- Firebase Cloud Messaging (opcional) ---
# Service account JSON de Firebase, codificado en Base64
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Resend para emails (opcional) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=VCDetection <alertas@tudominio.com>

# --- Servidor ---
PORT=3000
NODE_ENV=development
