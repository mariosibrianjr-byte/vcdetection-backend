# ============================================
# VCDetection Backend — Variables de Entorno
# ============================================
# Copiar este archivo como .env y llenar los valores

# --- Base de datos PostgreSQL ---
# Obtener de Render.com al crear la base de datos
DATABASE_URL=postgresql://usuario:password@host:5432/vcdetection

# --- JWT ---
JWT_SECRET=cambiar_por_un_string_secreto_largo_y_aleatorio

# --- Firebase Cloud Messaging ---
# Codificar el JSON del service account en base64:
#   En terminal: cat serviceAccount.json | base64
# O poner la ruta al archivo JSON:
FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# --- Resend (emails) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=alertas@tudominio.com

# --- Servidor ---
PORT=3000
NODE_ENV=development
