generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum Rol {
  ADMIN
  COORDINADOR
}

enum TipoAlerta {
  VAPE_CONFIRMADO
  CIGARRILLO
  ALTA_CONFIANZA
  PM25_ALTO
}

// ============================================
// Modelos
// ============================================

model Dispositivo {
  id              String    @id @default(cuid())
  nombre          String    @unique // "SALON_01"
  salon           String    // "Salón 1" o descripción legible
  ultimaConexion  DateTime  @default(now())
  online          Boolean   @default(true)

  lecturas        Lectura[]
  alertas         Alerta[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("dispositivos")
}

model Lectura {
  id              String    @id @default(cuid())
  dispositivoId   String
  dispositivo     Dispositivo @relation(fields: [dispositivoId], references: [id])

  ppm135          Float
  ppm2            Float
  humoDetectado   Boolean
  tipo            String    // "Aire limpio", "Vape confirmado", etc.
  picoSubito      Boolean
  temperatura     Float
  humedad         Float
  pm1             Float
  pm25            Float
  pm10            Float
  timestamp       String    // Timestamp ISO del ESP32

  fecha           DateTime  @default(now())

  @@index([dispositivoId, fecha])
  @@map("lecturas")
}

model Alerta {
  id              String      @id @default(cuid())
  dispositivoId   String
  dispositivo     Dispositivo @relation(fields: [dispositivoId], references: [id])

  tipo            TipoAlerta
  mensaje         String
  vista           Boolean     @default(false)

  fecha           DateTime    @default(now())

  @@index([dispositivoId, fecha])
  @@index([vista])
  @@map("alertas")
}

model Usuario {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String    // Hash bcrypt
  nombre          String
  rol             Rol       @default(ADMIN)
  tokenFCM        String?   // Token de Firebase Cloud Messaging

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("usuarios")
}
